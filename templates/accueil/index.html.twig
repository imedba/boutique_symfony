{% extends 'base.html.twig' %}

{% block title %}Catalogue{% endblock %}

{% block body %}

<main class="conteneur">

        <section class="catalogue-entete">
            <div>
                <h1>Catalogue</h1>
                <p class="compteur">12 modèles</p>
            </div>

            <form method="get" class="filtres">
                <select name="categorie">
                    <option value="">Toutes les catégories</option>
                    {% for categorie in categories %}
                    <option value="{{categorie}}">{{ categorie }}</option>
                    {% endfor %}
                </select>

                <select name="marque">
                    <option value="">Toutes les marques</option>
                    {% for marque in marques %}
                    <option value="{{marque}}">{{ marque }}</option>
                    {% endfor %}
                </select>

                <select name="tri">
                    <option value="">Trier par marque</option>
                    <option value="prix_asc">Prix croissant</option>
                    <option value="prix_desc">Prix décroissant</option>
                </select>

                <button type="submit" class="bouton">Filtrer</button>
                <a href="#" class="lien-reset">Réinitialiser</a>
            </form>
        </section>

        <section class="grille">

            {% for produit in produits %}
            <article class="carte">
                {# Ci dessous, a chaque produit du catalogue je mets en place le lien de redirection vers la page de détail de chaque produit. #}
                {# Grace à la methode path, je dis que au clic de la carte produit l'utilisateur sera redirigé vers la route qui s'apelle 'app_produit' (donc /produit/{id}) et l'id en parametre correspond à l'id du produit sur lequel on est #}
                <a href="{{ path('app_produit', {'id' : produit.id}) }}" class="carte-image">
                    <img src="{{produit.image}}" alt="Adidas Forum Low">
                    {% if produit.stock == 0 %}
                        <span class="badge badge-epuise">Épuisé</span>
                    {%  endif %}
                </a>
                <div class="carte-contenu">
                    <p class="carte-marque">{{produit.marque}}</p>
                    <h2 class="carte-nom">{{produit.nom}}</h2>
                    <span class="carte-categorie">{{produit.categorie}}</span>
                    <div class="carte-bas">
                        <span class="carte-prix">{{produit.prix}} €</span>
                        <a href="#" class="bouton bouton-petit">Voir</a>
                    </div>
                </div>
            </article>
            {% endfor %}

        </section>

    </main>
{% endblock %}